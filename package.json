{
  "name": "common",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/braces-patch.cjs --check",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/braces-patch.cjs && prisma generate",
