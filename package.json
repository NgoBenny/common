    "test": "node tests/regression.cjs && node tests/editor-transport.cjs && node tests/moderation.cjs && node tests/database-safety.cjs && node tests/backup-retention.cjs",
    "test:features": "node tests/features-integration.cjs && node tests/restrictions-integration.cjs",
    "test:runtime-role": "node tests/runtime-role.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "db:check": "node scripts/check-db.cjs",
    "db:backup": "node scripts/backup-db.cjs",
    "db:verify-backup": "node scripts/verify-backup.cjs",
    "db:baseline": "node scripts/baseline-db.cjs"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28",
      "sharp": "$sharp"
    },
    "brace-expansion@^1.1.7": "1.1.21"
  },
  "dependencies": {
    "@kinde-oss/kinde-auth-nextjs": "^2.13.1",
    "@prisma/client": "^5.13.0",
    "@radix-ui/react-avatar": "^1.2.6",
