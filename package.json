    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^15.5.27",
    "playwright": "1.63.0",
    "postcss": "^8",
    "prettier": "3.2.5",
    "prisma": "^5.13.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
